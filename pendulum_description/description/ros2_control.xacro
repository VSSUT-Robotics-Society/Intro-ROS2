<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="ros2_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- One Joint - Stepper -->
    <joint name="shaft_joint">
      <command_interface name="position" />
    </joint>
  </ros2_control>
</robot>