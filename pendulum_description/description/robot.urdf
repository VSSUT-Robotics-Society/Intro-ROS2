<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <link name="base_link" />
  <joint name="base_joint" type="continuous">
    <parent link="base_link" />
    <child link="pendulum_arm" />
  </joint>
  <link name="pendulum_arm">
    <visual>
      <origin xyz="0.0 0.0 -0.1" />
      <geometry>
        <cylinder radius="0.02" length="0.2" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.1" />
      <geometry>
        <cylinder radius="0.02" length="0.2" />
      </geometry>
    </collision>
    <!-- Inertial properties can be added here -->
  </link>
  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 -0.2" />
  </joint>
  <link name="pendulum_bob">
    <visual>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <!-- Inertial properties can be added here -->
  </link>
</robot>