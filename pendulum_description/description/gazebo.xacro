<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <!-- Joint state publisher (in-built) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>shaft_joint</joint_name>
      <joint_name>pendulum_joint</joint_name>
    </plugin>

    <!-- ROS2 Control (needs yaml file) -->
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find pendulum_description)/config/pendulum_controller.yaml</parameters>
    </plugin>
  </gazebo>
</robot>