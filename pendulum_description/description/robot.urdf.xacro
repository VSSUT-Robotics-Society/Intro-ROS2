<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="inertial_macros.xacro" />

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <box size="0.1 0.1 0.05" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <box size="0.1 0.1 0.05" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="2.0" x="0.1" y="0.1" z="0.1">
      <origin xyz="0 0 0.025" />
    </xacro:inertial_box>
  </link>

  <joint name="base_joint" type="continuous">
    <parent link="base_link" />
    <child link="pendulum_arm" />
    <origin xyz="0 0 0.35" />
  </joint>

  <link name="pendulum_arm">
    <visual>
      <origin xyz="0.0 0.0 -0.1" />
      <geometry>
        <cylinder radius="0.02" length="0.2" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.1" />
      <geometry>
        <cylinder radius="0.02" length="0.2" />
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.5" radius="0.02" length="0.2">
      <origin xyz="0.0 0.0 -0.1" />
    </xacro:inertial_cylinder>
  </link>

  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 -0.2" />
  </joint>

  <link name="pendulum_bob">
    <visual>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="1.0" radius="0.05">
      <origin xyz="0 0 0" />
    </xacro:inertial_sphere>
  </link>

</robot>