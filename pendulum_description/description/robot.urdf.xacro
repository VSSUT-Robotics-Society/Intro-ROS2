<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="inertial_macros.xacro" />
  <xacro:include filename="gazebo.xacro" />
  <xacro:include filename="ros2_control.xacro" />

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <cylinder length="0.05" radius="0.25" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <cylinder length="0.05" radius="0.25" />
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="5.0" radius="0.25" length="0.05">
      <origin xyz="0 0 0.025" />
    </xacro:inertial_cylinder>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_rod" />
    <origin xyz="0 0 0.05" />
  </joint>

  <link name="base_rod">
    <visual>
      <origin xyz="0 0 0.25" />
      <geometry>
        <cylinder radius="0.01" length="0.5" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" />
      <geometry>
        <cylinder radius="0.01" length="0.5" />
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.0" radius="0.01" length="0.5">
      <origin xyz="0 0 0.25" />
    </xacro:inertial_cylinder>
  </link>

  <joint name="motor_joint" type="fixed">
    <parent link="base_rod" />
    <child link="motor_link" />
    <origin xyz="0 0 0.5" />
  </joint>

  <link name="motor_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.1" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.34" x="0.1" y="0.1" z="0.1">
      <origin xyz="0 0 0.05" />
    </xacro:inertial_box>
  </link>

  <!-- Stepper moves this joint -->
  <joint name="shaft_joint" type="continuous">
    <parent link="motor_link" />
    <child link="shaft_link" />
    <origin xyz="0 0 0.055" rpy="0.0 ${pi/2} 0.0" />
    <limit effort="2.0" velocity="6.0" />
    <dynamics damping="0.1" friction="0.01" />
  </joint>

  <link name="shaft_link">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.5" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.01 0.5" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.135" x="0.01" y="0.01" z="0.5">
      <origin xyz="0 0 0.25" />
    </xacro:inertial_box>
  </link>

  <!-- Encoder reads this joint -->
  <joint name="pendulum_joint" type="continuous">
    <parent link="shaft_link" />
    <child link="pendulum_arm" />
    <origin xyz="0 0 -0.25" rpy="0.0 ${-pi/2} ${pi}" />
    <dynamics damping="0.05" friction="0.001" />
  </joint>

  <link name="pendulum_arm">
    <visual>
      <origin xyz="0.0 0.0 -0.2" />
      <geometry>
        <box size="0.02 0.02 0.4" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.2" />
      <geometry>
        <box size="0.02 0.02 0.4" />
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.432" x="0.02" y="0.02" z="0.4">
      <origin xyz="0.0 0.0 -0.2" />
    </xacro:inertial_box>
  </link>

  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 -0.4" />
  </joint>

  <link name="pendulum_bob">
    <visual>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
      <material name="orange">
        <color rgba="1 0.15 0 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05" />
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="0.0573" radius="0.05">
      <origin xyz="0 0 0" />
    </xacro:inertial_sphere>
  </link>

  <joint name="counterweight_joint" type="fixed">
    <parent link="shaft_link" />
    <child link="counterweight_link" />
    <origin xyz="0.0 0.0 0.25" />
  </joint>

  <link name="counterweight_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
      <xacro:inertial_box mass="0.785" x="0.05" y="0.05" z="0.05">
        <origin xyz="0 0 0" />
      </xacro:inertial_box>
    </visual>
  </link>

</robot>