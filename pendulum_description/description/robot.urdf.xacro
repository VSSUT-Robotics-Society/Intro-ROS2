<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="inertial_macros.xacro" />
  <xacro:include filename="gazebo.xacro" />

  <!-- Variables -->
  <xacro:property name="rail_height" value="0.5" />
  <xacro:property name="rail_length" value="0.5" />
  <xacro:property name="rail_size" value="0.015" />
  <xacro:property name="base_radius" value="0.03" />
  <xacro:property name="base_length" value="0.05" />
  <xacro:property name="base_mass" value="0.1" />
  <xacro:property name="pendulum_arm_length" value="0.3" />
  <xacro:property name="pendulum_arm_size" value="0.015" />
  <xacro:property name="pendulum_arm_mass" value="0.5" />
  <xacro:property name="pendulum_bob_radius" value="0.03" />
  <xacro:property name="pendulum_bob_mass" value="1.0" />

  <link name="world" />

  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="rail_link" />
    <origin xyz="0 0 ${rail_height}" rpy="0 0 ${pi/2}" />
  </joint>

  <link name="rail_link">

    <visual>
      <origin xyz="0 0 -${rail_size/2 + base_radius}" rpy="0 ${pi/2} 0" />
      <geometry>
        <box size="${rail_size} ${rail_size} ${rail_length}" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -${rail_size/2 + base_radius}" rpy="0 ${pi/2} 0" />
      <geometry>
        <box size="${rail_size} ${rail_size} ${rail_length}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${base_mass}" size="${rail_size} ${rail_size} ${rail_length}">
      <origin xyz="0 0 -${rail_size/2 + base_radius}" rpy="0 ${pi/2} 0" />
    </xacro:inertial_box>
  </link>

  <joint name="rail_joint" type="prismatic">
    <parent link="rail_link" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 ${-pi/2}" />
    <axis xyz="0 1 0" />
    <limit effort="100" velocity="0.5" lower="${-rail_length/2}" upper="${rail_length/2}" />
  </joint>

  <link name="base_link">

    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}" />
      </geometry>
      <material name="light_blue">
        <color rgba="0.1 0.1 1 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}" />
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="${base_mass}" radius="${base_radius}"
      length="${base_length}">
      <origin xyz="0 0 0.0" rpy="0 ${pi/2} 0" />
    </xacro:inertial_cylinder>
  </link>


  <joint name="base_joint" type="continuous">
    <parent link="base_link" />
    <child link="pendulum_arm" />
    <origin xyz="${base_length/2 + pendulum_arm_size/2} 0 0.0" />
  </joint>


  <link name="pendulum_arm">

    <visual>
      <origin xyz="0.0 0.0 ${-pendulum_arm_length/2}" />
      <geometry>
        <box size="${pendulum_arm_size} ${pendulum_arm_size} ${pendulum_arm_length}" />
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${-pendulum_arm_length/2}" />
      <geometry>
        <box size="${pendulum_arm_size} ${pendulum_arm_size} ${pendulum_arm_length}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${pendulum_arm_mass}"
      size="${pendulum_arm_size} ${pendulum_arm_size} ${pendulum_arm_length}">
      <origin xyz="0.0 0.0 ${-pendulum_arm_length/2}" />
    </xacro:inertial_box>
  </link>

  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 ${-pendulum_arm_length}" />
  </joint>

  <link name="pendulum_bob">

    <visual>
      <geometry>
        <sphere radius="${pendulum_bob_radius}" />
      </geometry>
      <material name="orange">
        <color rgba="1 0.25 0 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${pendulum_bob_radius}" />
      </geometry>
    </collision>

    <xacro:inertial_sphere mass="${pendulum_bob_mass}" radius="${pendulum_bob_radius}">
      <origin xyz="0 0 0" />
    </xacro:inertial_sphere>
  </link>

</robot>