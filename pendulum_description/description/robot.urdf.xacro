<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="inertial_macros.xacro" />
  <xacro:include filename="gazebo.xacro" />

  <!-- Variables -->
  <xacro:property name="pendulum_height" value="0.5" />
  <xacro:property name="actuator_radius" value="0.05" />
  <xacro:property name="actuator_height" value="0.1" />
  <xacro:property name="pendulum_length" value="0.305" />
  <xacro:property name="pendulum_mass" value="0.75" />
  <xacro:property name="bob_radius" value="0.025" />
  <xacro:property name="bob_mass" value="0.01" />

  <link name="world" />

  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 ${pi}" />
  </joint>

  <link name="base_link">

    <visual>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <box size="0.1 0.25 0.05" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <box size="0.1 0.25 0.05" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="1.0" x="0.1" y="0.25" z="0.05">
      <origin xyz="0 0 0.025" />
    </xacro:inertial_box>
  </link>

  <joint name="base_to_holder" type="fixed">
    <parent link="base_link" />
    <child link="holder_link" />
    <origin xyz="-${0.1/2 + 0.015/2} 0 0" rpy="0 0 0" />
  </joint>

  <link name="holder_link">
    <visual>
      <origin xyz="0.0 0.0 ${pendulum_height/2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_height}" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${pendulum_height/2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_height}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.5" x="0.015" y="0.015" z="${pendulum_height}">
      <origin xyz="0 0 ${pendulum_height/2}" />
    </xacro:inertial_box>
  </link>

  <joint name="holder_to_actuator" type="fixed">
    <parent link="holder_link" />
    <child link="actuator_link" />
    <origin xyz="0 0 ${pendulum_height}" rpy="0 ${pi/2} 0" />
  </joint>

  <link name="actuator_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="${actuator_radius}" length="${actuator_height}" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" />
      <geometry>
        <cylinder radius="${actuator_radius}" length="${actuator_height}" />
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="0.5" radius="${actuator_radius}" length="${actuator_height}">
      <origin xyz="0 0 0" />
    </xacro:inertial_cylinder>
  </link>

  <!-- TODO (optional assignment): Update this joint to start from `actuator_link` -->
  <!-- And update the name to `actuator_joint` throughout the project. -->
  <joint name="base_joint" type="continuous">
    <parent link="base_link" />
    <child link="pendulum_arm" />
    <origin xyz="0 0 ${pendulum_height}" rpy="${pi} 0 0" />
    <dynamics damping="1e-5" friction="0.035" />
  </joint>


  <link name="pendulum_arm">

    <visual>
      <origin xyz="0.0 0.0 ${-pendulum_length / 2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_length}" />
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${-pendulum_length / 2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_length}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.5" x="0.015" y="0.015" z="${pendulum_length}">
      <origin xyz="0 0 ${-pendulum_length / 2}" />
    </xacro:inertial_box>
  </link>

  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 ${-pendulum_length}" />
  </joint>

  <link name="pendulum_bob">

    <visual>
      <geometry>
        <sphere radius="${bob_radius}" />
      </geometry>
      <material name="orange">
        <color rgba="1 0.25 0 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${bob_radius}" />
      </geometry>
    </collision>

    <xacro:inertial_sphere mass="${bob_mass}" radius="${bob_radius}">
      <origin xyz="0 0 0" />
    </xacro:inertial_sphere>
  </link>

</robot>