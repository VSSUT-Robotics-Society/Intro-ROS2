<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="inertial_macros.xacro" />
  <xacro:include filename="gazebo.xacro" />

  <!-- Variables -->
  <xacro:property name="pendulum_height" value="0.5" />
  <xacro:property name="actuator_radius" value="0.1" />
  <xacro:property name="actuator_height" value="0.1" />
  <xacro:property name="shaft_length" value="0.5" />
  <xacro:property name="pendulum_length" value="0.305" />
  <xacro:property name="pendulum_mass" value="0.75" />
  <xacro:property name="bob_radius" value="0.025" />
  <xacro:property name="bob_mass" value="0.01" />

  <link name="world" />

  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <cylinder length="0.05" radius="0.25" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.025" />
      <geometry>
        <cylinder length="0.05" radius="0.25" />
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="5.0" radius="0.25" length="0.05">
      <origin xyz="0 0 0.025" />
    </xacro:inertial_cylinder>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_rod" />
    <origin xyz="0 0 0" rpy="0 0 ${pi}" />
  </joint>

  <link name="base_rod">
    <visual>
      <origin xyz="0.0 0.0 ${pendulum_height/2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_height}" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${pendulum_height/2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_height}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${pendulum_mass}" x="0.015" y="0.015" z="${pendulum_height}">
      <origin xyz="0 0 ${pendulum_height/2}" />
    </xacro:inertial_box>
  </link>

  <joint name="motor_joint" type="fixed">
    <parent link="base_rod" />
    <child link="motor_link" />
    <origin xyz="0 0 ${pendulum_height}" rpy="0 0 0" />
  </joint>

  <link name="motor_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" />
      <geometry>
        <box size="${actuator_radius} ${actuator_radius} ${actuator_height}" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 0.0" />
      <geometry>
        <box size="${actuator_radius} ${actuator_radius} ${actuator_height}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.432" x="${actuator_radius}" y="${actuator_radius}"
      z="${actuator_height}">
      <origin xyz="0.0 0.0 0.0" />
    </xacro:inertial_box>
  </link>

  <!-- *Stepper moves this joint -->
  <joint name="shaft_joint" type="continuous">
    <parent link="motor_link" />
    <child link="shaft_link" />
    <origin xyz="0 0 ${(actuator_height + 0.015)/2}" rpy="0 ${pi/2} 0" />
    <dynamics damping="1e-5" friction="0.035" />
  </joint>

  <link name="shaft_link">
    <visual>
      <geometry>
        <box size="0.015 0.015 ${shaft_length}" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.8 0.8 0.8 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.015 0.015 ${shaft_length}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.135" x="0.015" y="0.015" z="${shaft_length}">
      <origin xyz="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- *Encoder reads this joint -->
  <joint name="pendulum_joint" type="continuous">
    <parent link="shaft_link" />
    <child link="pendulum_arm" />
    <origin xyz="0 0 ${(shaft_length + 0.015)/2}" rpy="0 ${pi/2} 0" />
    <dynamics damping="1e-5" friction="0.035" />
  </joint>

  <link name="pendulum_arm">
    <visual>
      <origin xyz="0.0 0.0 ${-pendulum_length / 2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_length}" />
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${-pendulum_length / 2}" />
      <geometry>
        <box size="0.015 0.015 ${pendulum_length}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${pendulum_mass}" x="0.015" y="0.015" z="${pendulum_length}">
      <origin xyz="0 0 ${-pendulum_length / 2}" />
    </xacro:inertial_box>
  </link>

  <joint name="arm_to_bob" type="fixed">
    <parent link="pendulum_arm" />
    <child link="pendulum_bob" />
    <origin xyz="0 0 -${pendulum_length}" />
  </joint>

  <link name="pendulum_bob">
    <visual>
      <geometry>
        <sphere radius="${bob_radius}" />
      </geometry>
      <material name="orange">
        <color rgba="1 0.15 0 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${bob_radius}" />
      </geometry>
    </collision>
    <xacro:inertial_sphere mass="${bob_mass}" radius="${bob_radius}">
      <origin xyz="0 0 0" />
    </xacro:inertial_sphere>
  </link>

  <joint name="counterweight_joint" type="fixed">
    <parent link="shaft_link" />
    <child link="counterweight_link" />
    <origin xyz="0.0 0.0 -${shaft_length/2}" />
  </joint>

  <link name="counterweight_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1" />
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${pendulum_mass + bob_mass}" x="0.05" y="0.05" z="0.05">
      <origin xyz="0 0 0" />
    </xacro:inertial_box>
  </link>

</robot>